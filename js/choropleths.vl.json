      "url": "data/processed/rain_vs_yield.csv",
      "format": {
       "type": "csv",
       "parse": {
        "year": "number"
       }
      }
     },
     "transform": [
      {
       "filter": "datum.year == 2022"
      },
      {
       "calculate": "datum.yield_pct_of_avg",
       "as": "pct"
      },
      {
       "lookup": "state",
       "from": {
        "data": {
         "url": "data/processed/aus_states.topojson",
         "format": {
          "type": "topojson",
          "feature": "states"
         }
        },
        "key": "properties.name"
       },
       "as": "geo"
      },
      {
       "calculate": "datum.state + ' grew wheat at ' + format(datum.wheat_yield_t_ha, '.1f') + ' tonnes a hectare in ' + datum.season + ', ' + format(datum.pct, '.0f') + '% of its normal yield.'",
       "as": "tip"
      }
     ],
     "mark": {
      "type": "geoshape",
      "stroke": "#16222C",
      "strokeWidth": 0.6
     },
     "encoding": {
      "shape": {
       "field": "geo",
       "type": "geojson"
      },
      "color": {
       "field": "pct",
       "type": "quantitative",
       "scale": {
        "type": "threshold",
        "domain": [
         50,
         70,
         90,
         110,
         130,
         150
        ],
        "range": [
         "#8C510A",
         "#D8B365",
         "#EBCF8A",
         "#F4F7F2",
         "#A9DDD4",
         "#4FB3A6",
         "#01665E"
        ]
       },
       "legend": {
        "title": "% of the state's normal",
        "orient": "bottom",
        "direction": "horizontal",
        "symbolType": "square",
        "symbolSize": 180,
        "labelExpr": "datum.label == '< 50' ? 'under 50' : datum.label == '≥ 150' ? '150+' : datum.label",
        "columns": 7,
        "labelFontSize": 13,
        "titleFontSize": 13.5,
        "titleFontWeight": 600,
        "labelColor": "#3B372F",
        "titleColor": "#16222C",
        "symbolStrokeColor": "#8A7A62",
        "symbolStrokeWidth": 0.5
       }
      },
      "tooltip": [
       {
        "field": "tip",
        "type": "nominal",
        "title": "tip"
       }
      ]
     }
    },
    {
     "data": {
      "url": "data/processed/rain_vs_yield.csv",
      "format": {
       "type": "csv",
       "parse": {
        "year": "number"
       }
      }
     },
     "transform": [
      {
       "filter": "datum.year == 2022 && datum.state_code != 'TAS'"
      },
      {
       "calculate": "datum.yield_pct_of_avg",
       "as": "pct_v"
      },
      {
       "calculate": "format(datum.pct_v, '.0f') + '%'",
       "as": "lab"
      },
      {
       "calculate": "{'NSW':[146.6,-32.4],'VIC':[144.5,-36.9],'SA':[135.4,-30.2],'WA':[122.3,-26.0],'QLD':[144.0,-22.6]}[datum.state_code][0]",
       "as": "lon"
      },
      {
       "calculate": "{'NSW':[146.6,-32.4],'VIC':[144.5,-36.9],'SA':[135.4,-30.2],'WA':[122.3,-26.0],'QLD':[144.0,-22.6]}[datum.state_code][1]",
       "as": "lat"
      }
     ],
     "mark": {
      "type": "text",
      "fontSize": 13,
      "fontWeight": 600,
      "strokeWidth": 3.2,
      "strokeJoin": "round",
      "strokeOpacity": 0.9
     },
     "encoding": {
      "longitude": {
       "field": "lon",
       "type": "quantitative"
      },
      "latitude": {
       "field": "lat",
       "type": "quantitative"
      },
      "text": {
       "field": "lab"
      },
      "color": {
       "condition": {
        "test": "datum.pct_v < 50 || datum.pct_v >= 130",
        "value": "#16222C"
       },
       "value": "#F3EEDF"
      },
      "stroke": {
       "condition": {
        "test": "datum.pct_v < 50 || datum.pct_v >= 130",
        "value": "#16222C"
       },
       "value": "#F3EEDF"
      }
     }
    },
    {
     "data": {
      "url": "data/processed/rain_vs_yield.csv",
      "format": {
       "type": "csv",
       "parse": {
        "year": "number"
       }
      }
     },
     "transform": [
      {
       "filter": "datum.year == 2022 && datum.state_code != 'TAS'"
      },
      {
       "calculate": "datum.yield_pct_of_avg",
       "as": "pct_v"
      },
      {
       "calculate": "format(datum.pct_v, '.0f') + '%'",
       "as": "lab"
      },
      {
       "calculate": "{'NSW':[146.6,-32.4],'VIC':[144.5,-36.9],'SA':[135.4,-30.2],'WA':[122.3,-26.0],'QLD':[144.0,-22.6]}[datum.state_code][0]",
       "as": "lon"
      },
      {
       "calculate": "{'NSW':[146.6,-32.4],'VIC':[144.5,-36.9],'SA':[135.4,-30.2],'WA':[122.3,-26.0],'QLD':[144.0,-22.6]}[datum.state_code][1]",
       "as": "lat"
      }
     ],
     "mark": {
      "type": "text",
      "fontSize": 13,
      "fontWeight": 600,
      "color": "#16222C"
     },
     "encoding": {
      "longitude": {
       "field": "lon",
       "type": "quantitative"
      },
      "latitude": {
       "field": "lat",
       "type": "quantitative"
      },
      "text": {
       "field": "lab"
      },
      "color": {
       "condition": {
        "test": "datum.pct_v < 50 || datum.pct_v >= 130",
        "value": "#F3EEDF"
       },
       "value": "#16222C"
      }
     }
    }
   ]
  }
 ]
}