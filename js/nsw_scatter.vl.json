{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Connected scatterplot for New South Wales, 1989 to 2025: April to October rain against wheat yield, one dot per year joined in time order. Dry years sit low and left (2019: 118 mm and 0.8 t/ha), wet years high and right (2022: 495 mm and 3.0 t/ha).",
 "width": 440,
 "height": 380,
 "padding": {
  "left": 4,
  "right": 10,
  "top": 10,
  "bottom": 4
 },
 "config": {
  "font": "Bricolage Grotesque, system-ui, sans-serif",
  "background": null,
  "view": {
   "stroke": null
  },
  "axis": {
   "labelColor": "#3B372F",
   "titleColor": "#3B372F",
   "labelFont": "Bricolage Grotesque, system-ui, sans-serif",
   "titleFont": "Bricolage Grotesque, system-ui, sans-serif",
   "labelFontSize": 13,
   "titleFontSize": 13.5,
   "titleFontWeight": 400,
   "domainColor": "#9AA8A3",
   "tickColor": "#9AA8A3",
   "gridColor": "#C6D6D0"
  },
  "legend": {
   "labelFontSize": 13,
   "titleFontSize": 13.5
  }
 },
 "params": [
  {
   "name": "rain",
   "value": 130
  },
  {
   "name": "selYear",
   "value": 2019
  },
  {
   "name": "p0",
   "value": 2010
  },
  {
   "name": "p1",
   "value": 2019
  }
 ],
 "data": {
  "url": "data/processed/rain_vs_yield.csv",
  "format": {
   "type": "csv",
   "parse": {
    "year": "number"
   }
  }
 },
 "transform": [
  {
   "filter": "datum.state_code == 'NSW'"
  },
  {
   "calculate": "datum.rain_cool_mm * 100 / datum.rain_cool_pct_of_avg",
   "as": "normal_rain"
  },
  {
   "calculate": "datum.wheat_yield_t_ha * 100 / datum.yield_pct_of_avg",
   "as": "normal_yield"
  }
 ],
 "encoding": {
  "x": {
   "field": "rain_cool_mm",
   "type": "quantitative",
   "scale": {
    "domain": [
     80,
     520
    ],
    "nice": false
   },
   "axis": {
    "title": "Rain from April to October (mm)",
    "values": [
     100,
     200,
     300,
     400,
     500
    ],
    "grid": false
   }
  },
  "y": {
   "field": "wheat_yield_t_ha",
   "type": "quantitative",
   "scale": {
    "domain": [
     0,
     3.6
    ],
    "nice": false
   },
   "axis": {
    "title": "Wheat yield (tonnes a hectare)",
    "values": [
     0,
     1,
     2,
     3
    ],
    "grid": true
   }
  }
 },
 "layer": [
  {
   "data": {
    "values": [
     {}
    ]
   },
   "transform": [
    {
     "calculate": "rain - 30",
     "as": "lo"
    },
    {
     "calculate": "rain + 30",
     "as": "hi"
    }
   ],
   "mark": {
    "type": "rect",
    "color": "#8C510A",
    "opacity": 0.12
   },
   "encoding": {
    "x": {
     "field": "lo",
     "type": "quantitative"
    },
    "x2": {
     "field": "hi"
    },
    "y": {
     "value": 0
    },
    "y2": {
     "value": 380
    }
   }
  },
  {
   "data": {
    "values": [
     {}
    ]
   },
   "transform": [
    {
     "calculate": "rain - 30",
     "as": "lo"
    },
    {
     "calculate": "rain + 30",
     "as": "hi"
    },
    {
     "calculate": "format(rain - 30, 'd') + '–' + format(rain + 30, 'd') + ' mm'",
     "as": "lab"
    },
    {
     "calculate": "rain",
     "as": "mid"
    }
   ],
   "mark": {
    "type": "text",
    "color": "#8C510A",
    "fontSize": 13,
    "fontWeight": 600,
    "baseline": "top",
    "dy": 4
   },
   "encoding": {
    "x": {
     "field": "mid",
     "type": "quantitative"
    },
    "y": {
     "value": 0
    },
    "text": {
     "field": "lab"
    }
   }
  },
  {
   "transform": [
    {
     "aggregate": [
      {
       "op": "mean",
       "field": "normal_rain",
       "as": "nr"
      }
     ]
    }
   ],
   "mark": {
    "type": "rule",
    "color": "#5A5144",
    "strokeDash": [
     4,
     3
    ],
    "opacity": 0.7
   },
   "encoding": {
    "x": {
     "field": "nr",
     "type": "quantitative"
    },
    "y": null
   }
  },
  {
   "transform": [
    {
     "aggregate": [
      {
       "op": "mean",
       "field": "normal_rain",
       "as": "nr"
      }
     ]
    }
   ],
   "mark": {
    "type": "text",
    "color": "#5A5144",
    "fontSize": 13,
    "align": "left",
    "dx": 4,
    "baseline": "bottom",
    "y": 380,
    "dy": -4
   },
   "encoding": {
    "x": {
     "field": "nr",
     "type": "quantitative"
    },
    "y": null,
    "text": {
     "value": "normal rain"
    }
   }
  },
  {
   "transform": [
    {
     "aggregate": [
      {
       "op": "mean",
       "field": "normal_yield",
       "as": "ny"
      }
     ]
    }
   ],
   "mark": {
    "type": "rule",
    "color": "#5A5144",
    "strokeDash": [
     4,
     3
    ],
    "opacity": 0.7
   },
   "encoding": {
    "y": {
     "field": "ny",
     "type": "quantitative"
    },
    "x": null
   }
  },
  {
   "transform": [
    {
     "aggregate": [
      {
       "op": "mean",
       "field": "normal_yield",
       "as": "ny"
      }
     ]
    }
   ],
   "mark": {
    "type": "text",
    "color": "#5A5144",
    "fontSize": 13,
    "align": "right",
    "baseline": "bottom",
    "x": 440,
    "dy": -3
   },
   "encoding": {
    "y": {
     "field": "ny",
     "type": "quantitative"
    },
    "x": null,
    "text": {
     "value": "normal yield"
    }
   }
  },
  {
   "mark": {
    "type": "line",
    "color": "#16222C",
    "opacity": 0.6,
    "strokeWidth": 1.6,
    "interpolate": "linear"
   },
   "encoding": {
    "order": {
     "field": "year",
     "type": "quantitative"
    }
   },
   "transform": [
    {
     "filter": "datum.year >= p0 && datum.year <= p1"
    }
   ]
  },
  {
   "transform": [
    {
     "filter": "datum.year == selYear"
    }
   ],
   "mark": {
    "type": "point",
    "size": 520,
    "filled": false,
    "color": "#16222C",
    "strokeWidth": 1.6,
    "strokeDash": [
     3,
     2
    ]
   }
  },
  {
   "mark": {
    "type": "point",
    "shape": "circle",
    "filled": true,
    "stroke": "#16222C",
    "strokeWidth": 0.8,
    "cursor": "default"
   },
   "encoding": {
    "fill": {
     "condition": {
      "test": "abs(datum.rain_cool_mm - rain) <= 30",
      "value": "#8C510A"
     },
     "value": "#C8901E"
    },
    "size": {
     "condition": {
      "test": "abs(datum.rain_cool_mm - rain) <= 30",
      "value": 210
     },
     "value": 120
    },
    "opacity": {
     "condition": [
      {
       "test": "datum.year >= p0 && datum.year <= p1 && abs(datum.rain_cool_mm - rain) <= 30",
       "value": 1
      },
      {
       "test": "datum.year >= p0 && datum.year <= p1",
       "value": 0.85
      }
     ],
     "value": 0.15
    },
    "tooltip": [
     {
      "field": "tip",
      "type": "nominal",
      "title": "tip"
     }
    ]
   },
   "transform": [
    {
     "calculate": "'NSW, ' + datum.season + ': ' + format(datum.rain_cool_mm, '.0f') + ' mm of rain from April to October (' + format(datum.rain_cool_pct_of_avg, '.0f') + '% of normal) and wheat at ' + format(datum.wheat_yield_t_ha, '.1f') + ' tonnes a hectare (' + format(datum.yield_pct_of_avg, '.0f') + '% of normal).' + (datum.status == 'actual' ? '' : ' This is an ABARES ' + datum.status + '.')",
     "as": "tip"
    }
   ]
  },
  {
   "transform": [
    {
     "lookup": "year",
     "from": {
      "data": {
       "values": [
        {
         "year": 1994,
         "dx": 0,
         "dy": 16,
         "align": "center"
        },
        {
         "year": 2002,
         "dx": -11,
         "dy": -6,
         "align": "right"
        },
        {
         "year": 2019,
         "dx": 10,
         "dy": -10,
         "align": "left"
        },
        {
         "year": 2018,
         "dx": 11,
         "dy": 4,
         "align": "left"
        },
        {
         "year": 2022,
         "dx": 0,
         "dy": 16,
         "align": "center"
        }
       ]
      },
      "key": "year",
      "fields": [
       "dx",
       "dy",
       "align"
      ]
     }
    },
    {
     "filter": "(datum.align || datum.year == selYear) && datum.year >= p0 && datum.year <= p1"
    },
    {
     "calculate": "datum.align || 'left'",
     "as": "al"
    },
    {
     "calculate": "datum.align ? datum.dx : 12",
     "as": "ddx"
    },
    {
     "calculate": "datum.align ? datum.dy : -10",
     "as": "ddy"
    }
   ],
   "mark": {
    "type": "text",
    "fontSize": 13,
    "fontWeight": 600,
    "color": "#16222C",
    "align": {
     "expr": "datum.al"
    },
    "dx": {
     "expr": "datum.ddx"
    },
    "dy": {
     "expr": "datum.ddy"
    },
    "baseline": "middle"
   },
   "encoding": {
    "text": {
     "field": "year"
    },
    "color": {
     "condition": [
      {
       "test": "datum.year == 2019",
       "value": "#8C510A"
      },
      {
       "test": "datum.year == 2022",
       "value": "#01665E"
      }
     ],
     "value": "#16222C"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "(datum.year == p0 || datum.year == p1) && indexof([1994, 2002, 2018, 2019, 2022], datum.year) < 0 && datum.year != selYear"
    }
   ],
   "mark": {
    "type": "text",
    "fontSize": 13,
    "fontWeight": 600,
    "color": "#16222C",
    "dx": 11,
    "dy": -10,
    "baseline": "middle",
    "align": "left"
   },
   "encoding": {
    "text": {
     "field": "year"
    }
   }
  }
 ]
}