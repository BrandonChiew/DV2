{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Jitter plot of Australia's wheat harvest in each year from 1989 to 2025, grouped by Pacific pattern. El Nino years average 16.2 million tonnes, neutral years 22.0 and La Nina years 27.0. 2019 was a neutral year but the driest on record.",
 "width": 560,
 "height": 330,
 "padding": {
  "left": 4,
  "right": 8,
  "top": 8,
  "bottom": 4
 },
 "config": {
  "font": "IBM Plex Sans",
  "background": null,
  "view": {
   "stroke": null
  },
  "axis": {
   "labelColor": "#C9D6DC",
   "titleColor": "#C9D6DC",
   "labelFont": "IBM Plex Sans",
   "titleFont": "IBM Plex Sans",
   "labelFontSize": 12,
   "titleFontSize": 13,
   "titleFontWeight": 400,
   "domainColor": "#4A5B66",
   "tickColor": "#4A5B66",
   "gridColor": "#2A3A46"
  },
  "legend": {
   "labelColor": "#F3EEDF",
   "titleColor": "#F3EEDF",
   "labelFont": "IBM Plex Sans",
   "titleFont": "IBM Plex Sans",
   "labelFontSize": 12,
   "titleFontSize": 12
  }
 },
 "title": {
  "text": "Wheat harvest in every season, by Pacific pattern",
  "subtitle": "Each dot is one year, 1989 to 2025. The bar is the average for that pattern.",
  "anchor": "start",
  "color": "#F3EEDF",
  "subtitleColor": "#C9BFAE",
  "fontSize": 15,
  "fontWeight": 600,
  "subtitleFontSize": 12.5,
  "font": "IBM Plex Sans",
  "subtitleFont": "IBM Plex Sans",
  "offset": 12
 },
 "params": [
  {
   "name": "selYear",
   "value": 2019
  }
 ],
 "data": {
  "url": "data/processed/crops_by_state.csv",
  "format": {
   "type": "csv",
   "parse": {
    "year": "number",
    "production_kt": "number"
   }
  }
 },
 "transform": [
  {
   "filter": "datum.state_code == 'AUS' && datum.crop == 'wheat' && datum.year <= 2025"
  },
  {
   "calculate": "datum.production_kt / 1000",
   "as": "mt"
  },
  {
   "lookup": "year",
   "from": {
    "data": {
     "url": "data/processed/climate_drivers.csv",
     "format": {
      "type": "csv",
      "parse": {
       "year": "number"
      }
     }
    },
    "key": "year",
    "fields": [
     "enso"
    ]
   }
  },
  {
   "calculate": "datum.enso == 'El Nino' ? 0 : datum.enso == 'Neutral' ? 1 : 2",
   "as": "idx"
  },
  {
   "calculate": "datum.enso == 'El Nino' ? 'El Niño' : datum.enso == 'La Nina' ? 'La Niña' : 'Neutral'",
   "as": "phase"
  },
  {
   "calculate": "datum.idx + 0.72 * ((abs(sin(datum.year * 12.9898) * 43758.5453) % 1) - 0.5)",
   "as": "xj"
  }
 ],
 "layer": [
  {
   "transform": [
    {
     "aggregate": [
      {
       "op": "mean",
       "field": "mt",
       "as": "avg"
      },
      {
       "op": "count",
       "as": "n"
      }
     ],
     "groupby": [
      "idx",
      "phase"
     ]
    },
    {
     "calculate": "datum.idx - 0.4",
     "as": "xa"
    },
    {
     "calculate": "datum.idx + 0.4",
     "as": "xb"
    }
   ],
   "mark": {
    "type": "rule",
    "strokeWidth": 3,
    "color": "#F3EEDF",
    "opacity": 0.9
   },
   "encoding": {
    "x": {
     "field": "xa",
     "type": "quantitative",
     "scale": {
      "domain": [
       -0.6,
       2.6
      ],
      "nice": false,
      "zero": false
     }
    },
    "x2": {
     "field": "xb"
    },
    "y": {
     "field": "avg",
     "type": "quantitative"
    },
    "tooltip": [
     {
      "field": "phase",
      "title": "Pacific pattern"
     },
     {
      "field": "avg",
      "title": "Average harvest (Mt)",
      "format": ".1f"
     },
     {
      "field": "n",
      "title": "Years"
     }
    ]
   }
  },
  {
   "transform": [
    {
     "aggregate": [
      {
       "op": "mean",
       "field": "mt",
       "as": "avg"
      },
      {
       "op": "count",
       "as": "n"
      }
     ],
     "groupby": [
      "idx",
      "phase"
     ]
    },
    {
     "calculate": "'average ' + format(datum.avg, '.1f') + ' Mt'",
     "as": "lab"
    }
   ],
   "mark": {
    "type": "text",
    "baseline": "bottom",
    "dy": -6,
    "fontSize": 13,
    "fontWeight": 700,
    "color": "#F3EEDF"
   },
   "encoding": {
    "x": {
     "field": "idx",
     "type": "quantitative",
     "scale": {
      "domain": [
       -0.6,
       2.6
      ],
      "nice": false,
      "zero": false
     }
    },
    "y": {
     "value": 14
    },
    "text": {
     "field": "lab"
    }
   }
  },
  {
   "mark": {
    "type": "circle",
    "size": 105,
    "opacity": 0.95,
    "stroke": "#16222C",
    "strokeWidth": 1,
    "cursor": "pointer"
   },
   "encoding": {
    "x": {
     "field": "xj",
     "type": "quantitative",
     "scale": {
      "domain": [
       -0.6,
       2.6
      ],
      "nice": false,
      "zero": false
     },
     "axis": {
      "title": null,
      "values": [
       0,
       1,
       2
      ],
      "labelExpr": "['El Niño (usually dry)', 'Neutral', 'La Niña (usually wet)'][datum.value]",
      "labelFontSize": 14,
      "labelColor": "#F3EEDF",
      "grid": false,
      "ticks": false,
      "domain": false,
      "labelPadding": 8
     }
    },
    "y": {
     "field": "mt",
     "type": "quantitative",
     "scale": {
      "domain": [
       0,
       46
      ],
      "nice": false
     },
     "axis": {
      "title": "Million tonnes of wheat",
      "values": [
       0,
       10,
       20,
       30,
       40
      ],
      "grid": true,
      "domain": false,
      "ticks": false
     }
    },
    "color": {
     "field": "enso",
     "type": "nominal",
     "scale": {
      "domain": [
       "El Nino",
       "La Nina",
       "Neutral"
      ],
      "range": [
       "#E7A04B",
       "#9CC3D6",
       "#B9A58C"
      ]
     },
     "legend": null
    },
    "tooltip": [
     {
      "field": "year",
      "title": "Year",
      "format": "d"
     },
     {
      "field": "phase",
      "title": "Pacific pattern"
     },
     {
      "field": "mt",
      "title": "Wheat harvest (Mt)",
      "format": ".1f"
     }
    ]
   }
  },
  {
   "transform": [
    {
     "filter": "datum.year == selYear"
    }
   ],
   "mark": {
    "type": "point",
    "filled": false,
    "size": 330,
    "stroke": "#F3EEDF",
    "strokeWidth": 2.5
   },
   "encoding": {
    "x": {
     "field": "xj",
     "type": "quantitative",
     "scale": {
      "domain": [
       -0.6,
       2.6
      ],
      "nice": false,
      "zero": false
     }
    },
    "y": {
     "field": "mt",
     "type": "quantitative"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.year == 2006 || datum.year == 2022 || datum.year == 2019"
    },
    {
     "calculate": "datum.year == 2019 ? '2019: no El Niño, still the driest year' : toString(datum.year)",
     "as": "lab"
    }
   ],
   "mark": {
    "type": "text",
    "fontSize": 12,
    "fontWeight": 600,
    "dy": 20,
    "color": "#1B2A35",
    "stroke": "#1B2A35",
    "strokeWidth": 4,
    "strokeJoin": "round"
   },
   "encoding": {
    "x": {
     "field": "xj",
     "type": "quantitative",
     "scale": {
      "domain": [
       -0.6,
       2.6
      ],
      "nice": false,
      "zero": false
     }
    },
    "y": {
     "field": "mt",
     "type": "quantitative"
    },
    "text": {
     "field": "lab"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.year == 2006 || datum.year == 2022 || datum.year == 2019"
    },
    {
     "calculate": "datum.year == 2019 ? '2019: no El Niño, still the driest year' : toString(datum.year)",
     "as": "lab"
    }
   ],
   "mark": {
    "type": "text",
    "fontSize": 12,
    "fontWeight": 600,
    "dy": 20,
    "color": "#F3EEDF"
   },
   "encoding": {
    "x": {
     "field": "xj",
     "type": "quantitative",
     "scale": {
      "domain": [
       -0.6,
       2.6
      ],
      "nice": false,
      "zero": false
     }
    },
    "y": {
     "field": "mt",
     "type": "quantitative"
    },
    "text": {
     "field": "lab"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.year == 2002"
    },
    {
     "calculate": "datum.year == 2019 ? '2019: no El Niño, still the driest year' : toString(datum.year)",
     "as": "lab"
    }
   ],
   "mark": {
    "type": "text",
    "fontSize": 12,
    "fontWeight": 600,
    "align": "right",
    "dx": -10,
    "color": "#1B2A35",
    "stroke": "#1B2A35",
    "strokeWidth": 4,
    "strokeJoin": "round"
   },
   "encoding": {
    "x": {
     "field": "xj",
     "type": "quantitative",
     "scale": {
      "domain": [
       -0.6,
       2.6
      ],
      "nice": false,
      "zero": false
     }
    },
    "y": {
     "field": "mt",
     "type": "quantitative"
    },
    "text": {
     "field": "lab"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.year == 2002"
    },
    {
     "calculate": "datum.year == 2019 ? '2019: no El Niño, still the driest year' : toString(datum.year)",
     "as": "lab"
    }
   ],
   "mark": {
    "type": "text",
    "fontSize": 12,
    "fontWeight": 600,
    "align": "right",
    "dx": -10,
    "color": "#F3EEDF"
   },
   "encoding": {
    "x": {
     "field": "xj",
     "type": "quantitative",
     "scale": {
      "domain": [
       -0.6,
       2.6
      ],
      "nice": false,
      "zero": false
     }
    },
    "y": {
     "field": "mt",
     "type": "quantitative"
    },
    "text": {
     "field": "lab"
    }
   }
  }
 ]
}
